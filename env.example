# =====================
# MODULE VQA - ENVIRONMENT VARIABLES
# =====================

# --- Logging ---
LOG_LEVEL=INFO

# --- Paths (Dữ liệu đã index từ Layer 1/2/3 - BẮT BUỘC, module fail nếu thiếu) ---
DATA_ROOT=/data
KEYFRAME_DIR=/data/keyframes
CLIP_FEATURE_FILE=/data/clip_features.npy
OBJECT_JSON_DIR=/data/objects
METADATA_DIR=/data/metadata
SHOT_JSONL=/data/shots.jsonl
WHISPER_JSONL=/data/whisper.jsonl
TRANSCRIPT_JSONL=/data/shot_transcripts.jsonl

# --- Milvus (Vector DB) ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=keyframe_embeddings
MILVUS_VECTOR_FIELD=embedding
MILVUS_ID_FIELD=id
MILVUS_METADATA_FIELDS=video_id,frame_id,timestamp

# --- Embedding Model (PHẢI khớp với model đã dùng để tạo vector trong Milvus) ---
# Default ViT-B-32 chạy được ngay không cần checkpoint đặc biệt (zero-config dev).
# Nếu Milvus dùng Qwen3-VL-Embedding-8B, đổi 2 dòng dưới, KHÔNG sửa code.
EMBEDDING_MODEL_NAME=ViT-B-32
EMBEDDING_DIM=512

# --- LLM / VLM ---
# Nếu dùng local (vLLM / Ollama):
LLM_API_BASE=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL_NAME=Qwen2.5-7B-Instruct
# Nếu dùng OpenAI thay vì local, comment 3 dòng trên, bỏ comment 2 dòng dưới:
# OPENAI_API_KEY=sk-...
# LLM_MODEL_NAME=gpt-4o

VLM_MODEL_NAME=Qwen/Qwen2-VL-7B-Instruct
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Thresholds (placeholder - hiệu chỉnh bằng benchmark thật ở VQA-T07) ---
CONFIDENCE_MARGIN_THRESHOLD=0.15
CONFIDENCE_AGREEMENT_THRESHOLD=0.6

# --- Tier Rules ---
TIER0_MAX_ENTITIES=2
TIER0_MAX_RELATIONS=1

# --- Performance ---
MAX_BATCH_SIZE=32
USE_GPU=True
GPU_DEVICE=0

# --- Versioning (VQA-T09/T13 - bắt buộc mọi response có field này) ---
MODEL_VERSION_TAG=vqa-baseline-dev
